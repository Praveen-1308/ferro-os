FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# 1. Automated Debloater
RUN echo 'APT::Install-Recommends "0";\nAPT::Install-Suggests "0";\nDPkg::Post-Invoke {"rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/groff/* /usr/share/info/* /usr/share/locale/* || true";};' > /etc/apt/apt.conf.d/99ferro-nodoc

# 2. Core Python 3, Pip, SQLite, Mimalloc 2.0, and Developer Toolchain (gcc, make, git)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-psutil \
    sqlite3 \
    libmimalloc2.0 \
    ca-certificates \
    curl \
    gcc \
    libc6-dev \
    make \
    git \
    && rm -rf /var/lib/apt/lists/*

# 3. Copy FerroOS Pure-Rust Core, Package Keeper (rpk), Supervisor and Container Runtime
COPY --from=ferro-os-server:latest /usr/lib/libferro_io.so /usr/lib/libferro_io.so
COPY --from=ferro-os-pure:latest /usr/bin/ferro-pkg /usr/local/bin/rpk
COPY --from=ferro-os-pure:latest /usr/bin/ferro-core /usr/local/bin/ferro-core
COPY --from=ferro-os-pure:latest /usr/bin/ferro-superd /usr/local/bin/ferro-superd
COPY --from=ferro-os-pure:latest /usr/bin/ferrocage /usr/local/bin/ferrocage
RUN chmod +x /usr/local/bin/rpk /usr/local/bin/ferro-core /usr/local/bin/ferro-superd /usr/local/bin/ferrocage && /usr/local/bin/ferro-core --install-symlinks /usr/local/bin

# 4. Configure mimalloc zero-delay memory purging and LD_PRELOAD
ENV MIMALLOC_PURGE_DELAY=0
ENV MIMALLOC_PAGE_RESET=1
ENV MIMALLOC_RESERVE_OS_MEMORY=0

RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        echo "/usr/lib/aarch64-linux-gnu/libmimalloc.so.2" > /etc/ld.so.preload; \
    else \
        echo "/usr/lib/x86_64-linux-gnu/libmimalloc.so.2" > /etc/ld.so.preload; \
    fi && \
    echo "/usr/lib/libferro_io.so" >> /etc/ld.so.preload

# 5. Create unprivileged 'ferro' user & workspace
RUN useradd -m -s /bin/bash -u 1000 ferro && \
    mkdir -p /app && chown -R ferro:ferro /app

WORKDIR /app
USER ferro

CMD ["python3", "-c", "import sys; print(f'FerroOS Python QA Runtime Ready (Python {sys.version.split()[0]})')"]
