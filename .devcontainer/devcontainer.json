{
  "name": "FerroOS Cloud Environment & Live Web Desktop",
  "image": "mcr.microsoft.com/devcontainers/rust:latest",
  "postCreateCommand": "bash tools/setup-codespaces.sh",
  "postAttachCommand": "bash tools/run-codespaces-gui.sh &",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "FerroOS Live Web Desktop (noVNC)",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer"
      ]
    }
  }
}
