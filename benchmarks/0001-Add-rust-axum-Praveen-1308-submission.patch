+++ b/submissions/rust-axum-Praveen-1308/src/main.rs
@@ -0,0 +1,414 @@
+use axum::{
+    body::{Body, to_bytes},
+    extract::{Request, State},
+    http::{StatusCode, header},
+    response::Response,
+};
+use base64::{Engine, engine::general_purpose::URL_SAFE_NO_PAD};
+use hmac::{Hmac, Mac};
+use rusqlite::{Connection, OpenFlags, params};
+use serde::Serialize;
+use serde_json::Value;
+use sha2::Sha256;
+use std::{
+    env,
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    },
+    time::{Instant, SystemTime, UNIX_EPOCH},
+};
+use tokio::sync::{mpsc, oneshot};
+
+static CONNECTIONS: AtomicUsize = AtomicUsize::new(0);
+
+const FEED_SQL: &str = "SELECT p.id, p.body, p.created_at, u.username, (SELECT count(*) FROM likes l WHERE l.post_id = p.id) AS like_count FROM posts p JOIN users u ON u.id = p.user_id ORDER BY p.created_at DESC, p.id DESC LIMIT 20";
+const POST_BY_ID_SQL: &str = "SELECT p.id, p.body, p.created_at, u.username, (SELECT count(*) FROM likes l WHERE l.post_id = p.id) AS like_count FROM posts p JOIN users u ON u.id = p.user_id WHERE p.id = ?";
+
+type Reply = (u16, Vec<u8>);
+
+enum WriteCmd {
+    CreatePost {
+        user_id: i64,
+        username: String,
+        body: String,
+        resp: oneshot::Sender<Reply>,
+    },
+    LikePost {
+        user_id: i64,
+        post_id: i64,
+        resp: oneshot::Sender<Reply>,
+    },
+}
+
+#[derive(Clone)]
+struct AppState {
+    db_readers: Arc<Vec<parking_lot::Mutex<Connection>>>,
+    write_tx: mpsc::Sender<WriteCmd>,
+    secret: Vec<u8>,
+    started: Instant,
+    reader_idx: Arc<AtomicUsize>,
+}
+
+#[derive(Serialize)]
+struct Post {
+    id: i64,
+    body: String,
+    created_at: String,
+    author: String,
+    like_count: i64,
+}
+
+#[derive(Serialize)]
+struct SinglePost {
+    post: Post,
+}
+
+#[derive(Serialize)]
+struct FeedResponse {
+    posts: Vec<Post>,
+}
+
+#[derive(Serialize)]
+struct LikeResponse {
+    liked: bool,
+    already_liked: bool,
+    post_id: i64,
+}
+
+#[derive(Serialize)]
+struct ErrorResponse<'a> {
+    error: &'a str,
+}
+
+fn json_reply(status: u16, val: impl Serialize) -> Reply {
+    (status, serde_json::to_vec(&val).unwrap_or_default())
+}
+
+fn error_reply(status: u16, msg: &'static str) -> Reply {
+    json_reply(status, ErrorResponse { error: msg })
+}
+
+fn parse_positive_id(text: &str) -> Option<i64> {
+    if text.is_empty() || !text.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    text.parse::<i64>().ok().filter(|&n| n > 0 && n <= 9_007_199_254_740_991)
+}
+
+fn verify_jwt(secret: &[u8], auth_header: Option<&str>) -> Result<(i64, String), (u16, &'static str)> {
+    let auth = auth_header.ok_or((401, "missing bearer token"))?;
+    let token = auth.strip_prefix("Bearer ").ok_or((401, "missing bearer token"))?;
+    let invalid = (401, "invalid or expired token");
+
+    let parts: Vec<&str> = token.split('.').collect();
+    if parts.len() != 3 {
+        return Err(invalid);
+    }
+
+    let mut decoded = Vec::with_capacity(3);
+    for part in &parts {
+        if part.is_empty() {
+            return Err(invalid);
+        }
+        decoded.push(URL_SAFE_NO_PAD.decode(part).map_err(|_| invalid)?);
+    }
+
+    let mut mac = Hmac::<Sha256>::new_from_slice(secret).map_err(|_| invalid)?;
+    mac.update(parts[0].as_bytes());
+    mac.update(b".");
+    mac.update(parts[1].as_bytes());
+    mac.verify_slice(&decoded[2]).map_err(|_| invalid)?;
+
+    let head: Value = serde_json::from_slice(&decoded[0]).map_err(|_| invalid)?;
+    let claims: Value = serde_json::from_slice(&decoded[1]).map_err(|_| invalid)?;
+
+    if head.get("alg").and_then(|v| v.as_str()) != Some("HS256") {
+        return Err(invalid);
+    }
+
+    let now = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|_| invalid)?
+        .as_secs_f64();
+
+    let expiry = claims.get("exp").and_then(|v| v.as_f64()).ok_or(invalid)?;
+    if !expiry.is_finite() || expiry <= now {
+        return Err(invalid);
+    }
+
+    if let Some(nbf_val) = claims.get("nbf").and_then(|v| v.as_f64()) {
+        if !nbf_val.is_finite() || nbf_val > now {
+            return Err(invalid);
+        }
+    }
+
+    let payload_err = (401, "invalid token payload");
+    let sub_str = claims.get("sub").and_then(|v| v.as_str()).ok_or(payload_err)?;
+    let user_id = parse_positive_id(sub_str).ok_or(payload_err)?;
+    let username = claims.get("username").and_then(|v| v.as_str()).ok_or(payload_err)?;
+
+    Ok((user_id, username.to_string()))
+}
+
+fn configure_sqlite(conn: &Connection) -> rusqlite::Result<()> {
+    conn.execute_batch(
+        "PRAGMA journal_mode = WAL;
+         PRAGMA synchronous = NORMAL;
+         PRAGMA cache_size = -4000;
+         PRAGMA temp_store = MEMORY;
+         PRAGMA mmap_size = 67108864;
+         PRAGMA busy_timeout = 5000;"
+    )
+}
+
+fn run_writer_loop(db_path: String, mut rx: mpsc::Receiver<WriteCmd>) {
+    let conn = Connection::open(&db_path).expect("Open writer connection");
+    configure_sqlite(&conn).expect("Configure writer pragmas");
+
+    let mut insert_post_stmt = conn.prepare("INSERT INTO posts (user_id, body) VALUES (?, ?) RETURNING id, created_at").expect("prep insert post");
+    let mut check_post_stmt = conn.prepare("SELECT 1 FROM posts WHERE id = ?").expect("prep check post");
+    let mut insert_like_stmt = conn.prepare("INSERT INTO likes (user_id, post_id) VALUES (?, ?) ON CONFLICT (user_id, post_id) DO NOTHING").expect("prep insert like");
+
+    while let Some(cmd) = rx.blocking_recv() {
+        match cmd {
+            WriteCmd::CreatePost { user_id, username, body, resp } => {
+                let res = insert_post_stmt.query_row(params![user_id, body], |r| {
+                    let id: i64 = r.get(0)?;
+                    let created_at: String = r.get(1)?;
+                    Ok((id, created_at))
+                });
+                let reply = match res {
+                    Ok((id, created_at)) => json_reply(201, SinglePost {
+                        post: Post {
+                            id,
+                            body,
+                            created_at,
+                            author: username,
+                            like_count: 0,
+                        },
+                    }),
+                    Err(e) => {
+                        eprintln!("Error creating post: {e}");
+                        error_reply(500, "internal server error")
+                    }
+                };
+                let _ = resp.send(reply);
+            }
+            WriteCmd::LikePost { user_id, post_id, resp } => {
+                let post_exists = check_post_stmt.exists(params![post_id]).unwrap_or(false);
+                let reply = if !post_exists {
+                    error_reply(404, "post not found")
+                } else {
+                    let changes = insert_like_stmt.execute(params![user_id, post_id]).unwrap_or(0);
+                    if changes > 0 {
+                        json_reply(201, LikeResponse { liked: true, already_liked: false, post_id })
+                    } else {
+                        json_reply(200, LikeResponse { liked: true, already_liked: true, post_id })
+                    }
+                };
+                let _ = resp.send(reply);
+            }
+        }
+    }
+}
+
+async fn router_handler(State(state): State<AppState>, req: Request) -> Response {
+    let method = req.method().clone();
+    let path = req.uri().path().to_string();
+    let headers = req.headers().clone();
+
+    let auth_header = headers.get(header::AUTHORIZATION).and_then(|h| h.to_str().ok());
+
+    let (status, body_bytes) = if method == axum::http::Method::GET && path == "/health" {
+        let idx = state.reader_idx.fetch_add(1, Ordering::Relaxed) % state.db_readers.len();
+        let guard = state.db_readers[idx].lock();
+        match guard.query_row("SELECT 1", [], |r| r.get::<_, i64>(0)) {
+            Ok(_) => {
+                #[derive(Serialize)]
+                struct Health {
+                    status: &'static str,
+                    db: &'static str,
+                    uptime_s: u64,
+                }
+                json_reply(200, Health {
+                    status: "ok",
+                    db: "ok",
+                    uptime_s: state.started.elapsed().as_secs(),
+                })
+            }
+            Err(e) => {
+                #[derive(Serialize)]
+                struct Degraded {
+                    status: &'static str,
+                    db: &'static str,
+                    error: String,
+                }
+                json_reply(503, Degraded {
+                    status: "degraded",
+                    db: "unreachable",
+                    error: e.to_string(),
+                })
+            }
+        }
+    } else if method == axum::http::Method::GET && path == "/feed" {
+        let idx = state.reader_idx.fetch_add(1, Ordering::Relaxed) % state.db_readers.len();
+        let guard = state.db_readers[idx].lock();
+        let mut stmt = guard.prepare_cached(FEED_SQL).unwrap();
+        let posts = stmt.query_map([], |r| {
+            Ok(Post {
+                id: r.get(0)?,
+                body: r.get(1)?,
+                created_at: r.get(2)?,
+                author: r.get(3)?,
+                like_count: r.get(4)?,
+            })
+        }).and_then(|mapped| mapped.collect::<Result<Vec<Post>, _>>());
+
+        match posts {
+            Ok(p) => json_reply(200, FeedResponse { posts: p }),
+            Err(_) => error_reply(500, "internal server error"),
+        }
+    } else if method == axum::http::Method::GET && path.starts_with("/posts/") {
+        let id_str = &path["/posts/".len()..];
+        if let Some(post_id) = parse_positive_id(id_str) {
+            let idx = state.reader_idx.fetch_add(1, Ordering::Relaxed) % state.db_readers.len();
+            let guard = state.db_readers[idx].lock();
+            let mut stmt = guard.prepare_cached(POST_BY_ID_SQL).unwrap();
+            let mut rows = stmt.query(params![post_id]).unwrap();
+            if let Some(r) = rows.next().unwrap() {
+                let post = Post {
+                    id: r.get(0).unwrap(),
+                    body: r.get(1).unwrap(),
+                    created_at: r.get(2).unwrap(),
+                    author: r.get(3).unwrap(),
+                    like_count: r.get(4).unwrap(),
+                };
+                json_reply(200, SinglePost { post })
+            } else {
+                error_reply(404, "post not found")
+            }
+        } else {
+            error_reply(400, "invalid post id")
+        }
+    } else if method == axum::http::Method::POST && path == "/posts" {
+        match verify_jwt(&state.secret, auth_header) {
+            Ok((user_id, username)) => {
+                let body_raw = to_bytes(req.into_body(), 16384).await.unwrap_or_default();
+                match serde_json::from_slice::<Value>(&body_raw) {
+                    Ok(json) => {
+                        match json.get("body").and_then(|v| v.as_str()) {
+                            Some(body_str) => {
+                                let trimmed = body_str.trim();
+                                if trimmed.is_empty() {
+                                    error_reply(400, "body is required")
+                                } else if trimmed.chars().count() > 500 {
+                                    error_reply(400, "body must be at most 500 characters")
+                                } else {
+                                    let (tx, rx) = oneshot::channel();
+                                    let cmd = WriteCmd::CreatePost {
+                                        user_id,
+                                        username,
+                                        body: trimmed.to_string(),
+                                        resp: tx,
+                                    };
+                                    let _ = state.write_tx.send(cmd).await;
+                                    rx.await.unwrap_or_else(|_| error_reply(500, "internal server error"))
+                                }
+                            }
+                            None => error_reply(400, "body is required"),
+                        }
+                    }
+                    Err(_) => error_reply(400, "malformed JSON body"),
+                }
+            }
+            Err((code, msg)) => error_reply(code, msg),
+        }
+    } else if method == axum::http::Method::POST && path.starts_with("/posts/") && path.ends_with("/like") {
+        // AUTH CHECK FIRST (Requirement of SPEC and test.sh!)
+        match verify_jwt(&state.secret, auth_header) {
+            Ok((user_id, _)) => {
+                let sub_path = &path["/posts/".len()..path.len() - "/like".len()];
+                if let Some(post_id) = parse_positive_id(sub_path) {
+                    let (tx, rx) = oneshot::channel();
+                    let cmd = WriteCmd::LikePost {
+                        user_id,
+                        post_id,
+                        resp: tx,
+                    };
+                    let _ = state.write_tx.send(cmd).await;
+                    rx.await.unwrap_or_else(|_| error_reply(500, "internal server error"))
+                } else {
+                    error_reply(400, "invalid post id")
+                }
+            }
+            Err((code, msg)) => error_reply(code, msg),
+        }
+    } else {
+        error_reply(404, "not found")
+    };
+
+    let mut response = Response::builder()
+        .status(StatusCode::from_u16(status).unwrap_or(StatusCode::INTERNAL_SERVER_ERROR))
+        .header(header::CONTENT_TYPE, "application/json")
+        .body(Body::from(body_bytes))
+        .unwrap();
+
+    // Keepalive headers
+    let cur_conns = CONNECTIONS.load(Ordering::Relaxed);
+    if cur_conns > 60000 {
+        response.headers_mut().insert(header::CONNECTION, "close".parse().unwrap());
+    } else {
+        response.headers_mut().insert(header::CONNECTION, "keep-alive".parse().unwrap());
+    }
+
+    response
+}
+
+#[tokio::main]
+async fn main() {
+    let db_path = env::var("SQLITE_PATH").unwrap_or_else(|_| "/tmp/feed.db".to_string());
+    let secret = env::var("JWT_SECRET").unwrap_or_else(|_| "twelve-dollar-challenge".to_string()).into_bytes();
+    let host = env::var("HOST").unwrap_or_else(|_| "0.0.0.0".to_string());
+    let port = env::var("PORT").unwrap_or_else(|_| "3000".to_string());
+    let addr = format!("{}:{}", host, port);
+
+    // Warm-up database & configure WAL
+    {
+        let conn = Connection::open(&db_path).expect("Initial db connection");
+        configure_sqlite(&conn).expect("Initial sqlite config");
+    }
+
+    // Spawn dedicated write worker thread
+    let (write_tx, write_rx) = mpsc::channel(10000);
+    let writer_db_path = db_path.clone();
+    std::thread::spawn(move || {
+        run_writer_loop(writer_db_path, write_rx);
+    });
+
+    // Create Reader Connection Pool (tight 4-connection pool)
+    let num_readers = 4;
+    let mut readers = Vec::with_capacity(num_readers);
+    for _ in 0..num_readers {
+        let conn = Connection::open_with_flags(&db_path, OpenFlags::SQLITE_OPEN_READ_WRITE | OpenFlags::SQLITE_OPEN_NO_MUTEX).expect("Open reader");
+        configure_sqlite(&conn).expect("Configure reader pragmas");
+        readers.push(parking_lot::Mutex::new(conn));
+    }
+
+    let state = AppState {
+        db_readers: Arc::new(readers),
+        write_tx,
+        secret,
+        started: Instant::now(),
+        reader_idx: Arc::new(AtomicUsize::new(0)),
+    };
+
+    let app = axum::Router::new()
+        .fallback(router_handler)
+        .with_state(state);
+
+    let listener = tokio::net::TcpListener::bind(&addr).await.expect("Bind TCP listener");
+    println!("🚀 [Ferro-C500K Server] Listening on http://{}", addr);
+
+    axum::serve(listener, app).await.expect("Axum server run");
+}
