#!/usr/bin/env python3
"""
FerroOS Command & Task Hub
A next-generation task-oriented control deck outmatching conventional desktop UIs.
Provides:
1. Dynamic Task Workspaces (Dev Studio, Telemetry HUD, Web Research, Zen Mode)
2. Live Hardware Telemetry & Real-Time Resource Gauges
3. Fast Omnibar & Shell Command Quick-Runner
4. Quick System Diagnostics & App Store Integration
"""

import os
import sys
import time
import subprocess
import threading
import tkinter as tk
from tkinter import ttk, messagebox

# Color Palette (Deep Cyberpunk / Carbon Dark)
BG_MAIN = "#070b14"
BG_CARD = "#0f172a"
BG_INPUT = "#1e293b"
FG_TEXT = "#f8fafc"
FG_MUTED = "#94a3b8"
ACCENT_CYAN = "#38bdf8"
ACCENT_GREEN = "#22c55e"
ACCENT_YELLOW = "#eab308"
ACCENT_PURPLE = "#a855f7"
ACCENT_RED = "#ef4444"
BORDER_COLOR = "#334155"

class FerroHubApp:
    def __init__(self, root):
        self.root = root
        self.root.title("FerroOS Command & Task Deck")
        self.root.geometry("820x640")
        self.root.configure(bg=BG_MAIN)
        self.root.minsize(780, 600)

        # Style configuration
        self.setup_styles()

        # Build UI Sections
        self.build_header()
        self.build_omnibar()
        self.build_workspaces()
        self.build_telemetry()
        self.build_quick_actions()
        self.build_footer()

        # Start background telemetry poller
        self.running = True
        self.telemetry_thread = threading.Thread(target=self.poll_telemetry, daemon=True)
        self.telemetry_thread.start()

    def setup_styles(self):
        style = ttk.Style()
        style.theme_use("clam")
        style.configure("TProgressbar",
                        thickness=12,
                        troughcolor=BG_INPUT,
                        background=ACCENT_CYAN,
                        bordercolor=BG_INPUT,
                        lightcolor=ACCENT_CYAN,
                        darkcolor=ACCENT_CYAN)

    def build_header(self):
        header_frame = tk.Frame(self.root, bg=BG_MAIN)
        header_frame.pack(fill="x", padx=20, pady=(16, 8))

        # Title and Badge
        title_box = tk.Frame(header_frame, bg=BG_MAIN)
        title_box.pack(side="left")

        logo_label = tk.Label(title_box, text="⚡ FERRO", font=("Helvetica", 18, "bold"), fg=ACCENT_CYAN, bg=BG_MAIN)
        logo_label.pack(side="left")

        deck_label = tk.Label(title_box, text="COMMAND DECK", font=("Helvetica", 18, "bold"), fg=FG_TEXT, bg=BG_MAIN)
        deck_label.pack(side="left", padx=(6, 12))

        badge = tk.Label(title_box, text=" RUST CORE v0.1 ", font=("Helvetica", 9, "bold"), fg="#000000", bg=ACCENT_GREEN, padx=6, pady=2)
        badge.pack(side="left")

        # Top Right Status
        status_box = tk.Frame(header_frame, bg=BG_MAIN)
        status_box.pack(side="right")

        self.clock_label = tk.Label(status_box, text="", font=("Monospace", 11, "bold"), fg=FG_TEXT, bg=BG_MAIN)
        self.clock_label.pack(anchor="e")

        kernel_label = tk.Label(status_box, text="64-Bit Long Mode • Linux 6.8 • 0.8s Boot", font=("Helvetica", 9), fg=FG_MUTED, bg=BG_MAIN)
        kernel_label.pack(anchor="e")

    def build_omnibar(self):
        omni_frame = tk.Frame(self.root, bg=BG_CARD, highlightbackground=BORDER_COLOR, highlightthickness=1)
        omni_frame.pack(fill="x", padx=20, pady=8)

        prompt_lbl = tk.Label(omni_frame, text=" ❯_ ", font=("Monospace", 14, "bold"), fg=ACCENT_CYAN, bg=BG_CARD)
        prompt_lbl.pack(side="left", padx=(10, 4), pady=10)

        self.omni_entry = tk.Entry(omni_frame, font=("Helvetica", 12), fg=FG_TEXT, bg=BG_CARD,
                                   insertbackground=ACCENT_CYAN, bd=0, relief="flat")
        self.omni_entry.pack(side="left", fill="x", expand=True, padx=8, pady=10)
        self.omni_entry.insert(0, "Type a command, calculation (e.g. 256*1024), or app name and press Enter...")
        self.omni_entry.bind("<FocusIn>", self.on_omni_focus_in)
        self.omni_entry.bind("<Return>", self.on_omni_execute)

        exec_btn = tk.Button(omni_frame, text="RUN", font=("Helvetica", 10, "bold"),
                             fg="#000000", bg=ACCENT_CYAN, activebackground="#0284c7", activeforeground="#ffffff",
                             relief="flat", padx=14, pady=4, cursor="hand2", command=self.on_omni_execute)
        exec_btn.pack(side="right", padx=10, pady=8)

    def on_omni_focus_in(self, event):
        if "Type a command" in self.omni_entry.get():
            self.omni_entry.delete(0, tk.END)

    def on_omni_execute(self, event=None):
        cmd = self.omni_entry.get().strip()
        if not cmd or "Type a command" in cmd:
            return

        # Check if calculation
        try:
            # Safe eval of math expressions
            allowed_chars = set("0123456789+-*/(). %^")
            if all(c in allowed_chars for c in cmd):
                res = eval(cmd)
                messagebox.showinfo("Ferro Omnibar Calculator", f"Expression: {cmd}\nResult: {res}")
                return
        except Exception:
            pass

        # Execute as shell command in background
        try:
            subprocess.Popen(["sh", "-c", cmd], start_new_session=True)
            self.omni_entry.delete(0, tk.END)
            self.omni_entry.insert(0, f"Executed: {cmd}")
        except Exception as e:
            messagebox.showerror("Execution Error", str(e))

    def build_workspaces(self):
        ws_container = tk.LabelFrame(self.root, text=" 🚀 TASK WORKSPACE MATRIX (Instant Tiling & Context Switching) ",
                                     font=("Helvetica", 10, "bold"), fg=ACCENT_YELLOW, bg=BG_MAIN,
                                     highlightbackground=BORDER_COLOR, highlightthickness=1)
        ws_container.pack(fill="x", padx=20, pady=8)

        grid_frame = tk.Frame(ws_container, bg=BG_MAIN)
        grid_frame.pack(fill="x", padx=12, pady=10)

        # 4 Specialized Workspaces
        workspaces = [
            ("🛠️ Dev Studio", "Auto-tile Terminal + Code Editor + Git", self.launch_dev_studio, ACCENT_CYAN),
            ("📊 Telemetry HUD", "Side-by-side Htop + System Specs", self.launch_telemetry_hud, ACCENT_GREEN),
            ("🌐 Web Research", "Firefox Browser + Fast Scratchpad", self.launch_web_research, ACCENT_PURPLE),
            ("🧘 Clean Desktop", "Minimize windows & restore clean focus", self.clean_desktop, FG_MUTED),
        ]

        for i, (title, desc, action, color) in enumerate(workspaces):
            card = tk.Frame(grid_frame, bg=BG_CARD, highlightbackground=BORDER_COLOR, highlightthickness=1, padx=10, pady=8)
            card.grid(row=0, column=i, padx=6, sticky="nsew")
            grid_frame.columnconfigure(i, weight=1)

            btn = tk.Button(card, text=title, font=("Helvetica", 11, "bold"),
                            fg=color, bg=BG_INPUT, activebackground=BORDER_COLOR, activeforeground=color,
                            relief="flat", cursor="hand2", command=action)
            btn.pack(fill="x", pady=(0, 4))

            lbl = tk.Label(card, text=desc, font=("Helvetica", 8), fg=FG_MUTED, bg=BG_CARD, wraplength=140)
            lbl.pack()

    def launch_dev_studio(self):
        threading.Thread(target=self._launch_dev_studio_thread, daemon=True).start()

    def _launch_dev_studio_thread(self):
        # Open Editor and Terminal and position them
        subprocess.Popen(["mousepad", "/home/ferro/workspace_scratchpad.txt"])
        subprocess.Popen(["xfce4-terminal"])
        time.sleep(0.8)
        # Position windows with wmctrl
        os.system("wmctrl -r 'workspace_scratchpad' -e 0,50,60,580,680 2>/dev/null")
        os.system("wmctrl -r 'Terminal' -e 0,640,60,600,680 2>/dev/null")

    def launch_telemetry_hud(self):
        threading.Thread(target=self._launch_telemetry_hud_thread, daemon=True).start()

    def _launch_telemetry_hud_thread(self):
        subprocess.Popen(["xfce4-terminal", "-T", "FerroOS-Htop", "-e", "htop"])
        subprocess.Popen(["xfce4-taskmanager"])
        time.sleep(0.8)
        os.system("wmctrl -r 'FerroOS-Htop' -e 0,50,60,600,680 2>/dev/null")
        os.system("wmctrl -r 'Task Manager' -e 0,660,60,580,680 2>/dev/null")

    def launch_web_research(self):
        threading.Thread(target=self._launch_web_research_thread, daemon=True).start()

    def _launch_web_research_thread(self):
        subprocess.Popen(["firefox"])
        subprocess.Popen(["mousepad", "/home/ferro/research_notes.txt"])
        time.sleep(1.0)
        os.system("wmctrl -r 'Firefox' -e 0,40,50,750,700 2>/dev/null")
        os.system("wmctrl -r 'research_notes' -e 0,800,50,440,700 2>/dev/null")

    def clean_desktop(self):
        os.system("wmctrl -k on") # Show desktop

    def build_telemetry(self):
        telem_box = tk.LabelFrame(self.root, text=" 📈 REAL-TIME KERNEL & HARDWARE TELEMETRY ",
                                  font=("Helvetica", 10, "bold"), fg=ACCENT_CYAN, bg=BG_MAIN,
                                  highlightbackground=BORDER_COLOR, highlightthickness=1)
        telem_box.pack(fill="x", padx=20, pady=8)

        cols_frame = tk.Frame(telem_box, bg=BG_MAIN)
        cols_frame.pack(fill="x", padx=12, pady=10)

        # RAM Gauge
        ram_card = tk.Frame(cols_frame, bg=BG_CARD, highlightbackground=BORDER_COLOR, highlightthickness=1, padx=12, pady=8)
        ram_card.grid(row=0, column=0, padx=6, sticky="nsew")
        cols_frame.columnconfigure(0, weight=1)

        tk.Label(ram_card, text="RAM MEMORY (DYN MMU)", font=("Helvetica", 9, "bold"), fg=ACCENT_GREEN, bg=BG_CARD).pack(anchor="w")
        self.ram_val_lbl = tk.Label(ram_card, text="Loading...", font=("Monospace", 11, "bold"), fg=FG_TEXT, bg=BG_CARD)
        self.ram_val_lbl.pack(anchor="w", pady=(2, 4))
        self.ram_bar = ttk.Progressbar(ram_card, style="TProgressbar", maximum=100)
        self.ram_bar.pack(fill="x")

        # CPU / Tasks
        cpu_card = tk.Frame(cols_frame, bg=BG_CARD, highlightbackground=BORDER_COLOR, highlightthickness=1, padx=12, pady=8)
        cpu_card.grid(row=0, column=1, padx=6, sticky="nsew")
        cols_frame.columnconfigure(1, weight=1)

        tk.Label(cpu_card, text="PROCESS SCHEDULER", font=("Helvetica", 9, "bold"), fg=ACCENT_CYAN, bg=BG_CARD).pack(anchor="w")
        self.cpu_val_lbl = tk.Label(cpu_card, text="Loading...", font=("Monospace", 11, "bold"), fg=FG_TEXT, bg=BG_CARD)
        self.cpu_val_lbl.pack(anchor="w", pady=(2, 4))
        self.cpu_bar = ttk.Progressbar(cpu_card, style="TProgressbar", maximum=100)
        self.cpu_bar.pack(fill="x")

        # Storage & Network
        io_card = tk.Frame(cols_frame, bg=BG_CARD, highlightbackground=BORDER_COLOR, highlightthickness=1, padx=12, pady=8)
        io_card.grid(row=0, column=2, padx=6, sticky="nsew")
        cols_frame.columnconfigure(2, weight=1)

        tk.Label(io_card, text="STORAGE & IO", font=("Helvetica", 9, "bold"), fg=ACCENT_PURPLE, bg=BG_CARD).pack(anchor="w")
        self.io_val_lbl = tk.Label(io_card, text="Loading...", font=("Monospace", 11, "bold"), fg=FG_TEXT, bg=BG_CARD)
        self.io_val_lbl.pack(anchor="w", pady=(2, 4))
        self.io_bar = ttk.Progressbar(io_card, style="TProgressbar", maximum=100)
        self.io_bar.pack(fill="x")

    def build_quick_actions(self):
        action_frame = tk.Frame(self.root, bg=BG_MAIN)
        action_frame.pack(fill="x", padx=20, pady=8)

        actions = [
            ("🛍️ App Store", "ferro-store", ACCENT_CYAN),
            ("🌐 Firefox", "firefox", ACCENT_YELLOW),
            ("💻 Neofetch", "xfce4-terminal -e neofetch", ACCENT_GREEN),
            ("🔬 Run OS Verification Suite", "xfce4-terminal -T 'FerroOS Compliance Suite' -e 'python3 /usr/local/bin/os_verification_suite.py; read -p \"Press enter to exit...\"'", ACCENT_PURPLE),
        ]

        for title, cmd, color in actions:
            btn = tk.Button(action_frame, text=title, font=("Helvetica", 10, "bold"),
                            fg=color, bg=BG_CARD, activebackground=BORDER_COLOR, activeforeground=color,
                            relief="flat", highlightbackground=BORDER_COLOR, highlightthickness=1,
                            padx=12, pady=8, cursor="hand2",
                            command=lambda c=cmd: subprocess.Popen(["sh", "-c", c]))
            btn.pack(side="left", padx=4, expand=True, fill="x")

    def build_footer(self):
        footer = tk.Frame(self.root, bg=BG_MAIN)
        footer.pack(side="bottom", fill="x", padx=20, pady=(4, 12))

        lbl = tk.Label(footer, text="FerroOS Architecture: 100% Rust Userland (ferro-init PID 1, ferro-core, rpk, ferro-gui) • Zero Telemetry • Zero Bloat",
                       font=("Helvetica", 8), fg=FG_MUTED, bg=BG_MAIN)
        lbl.pack(side="left")

    def poll_telemetry(self):
        while self.running:
            try:
                # Clock
                cur_time = time.strftime("%H:%M:%S • %b %d")
                self.clock_label.config(text=cur_time)

                # RAM
                mem_total = 0
                mem_avail = 0
                with open("/proc/meminfo", "r") as f:
                    for line in f:
                        if line.startswith("MemTotal:"):
                            mem_total = int(line.split()[1])
                        elif line.startswith("MemAvailable:"):
                            mem_avail = int(line.split()[1])

                used_mb = (mem_total - mem_avail) // 1024
                total_mb = mem_total // 1024
                ram_pct = int((used_mb / total_mb) * 100) if total_mb > 0 else 0
                self.ram_val_lbl.config(text=f"{used_mb} MiB / {total_mb} MiB ({ram_pct}%)")
                self.ram_bar["value"] = ram_pct

                # Processes
                pids = [p for p in os.listdir("/proc") if p.isdigit()]
                proc_count = len(pids)
                self.cpu_val_lbl.config(text=f"{proc_count} Active Tasks (CFS Fair)")
                self.cpu_bar["value"] = min(100, proc_count * 2)

                # Storage
                st = os.statvfs("/")
                total_gb = (st.f_blocks * st.f_frsize) / (1024**3)
                free_gb = (st.f_bavail * st.f_frsize) / (1024**3)
                used_gb = total_gb - free_gb
                disk_pct = int((used_gb / total_gb) * 100) if total_gb > 0 else 0
                self.io_val_lbl.config(text=f"{used_gb:.1f}G / {total_gb:.1f}G ({disk_pct}%)")
                self.io_bar["value"] = disk_pct

            except Exception:
                pass
            time.sleep(1.0)

if __name__ == "__main__":
    root = tk.Tk()
    app = FerroHubApp(root)
    root.mainloop()
